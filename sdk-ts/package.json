{
  "name": "ai-hist",
  "version": "0.18.3",
  "description": "Local history ingestion, storage, evidence, SDK, CLI and MCP server.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ai-hist": "./dist/cli.js",
    "ai-hist-mcp": "./dist/mcp-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp-server": {
      "types": "./dist/mcp-server.d.ts",
      "default": "./dist/mcp-server.js"
    },
    "./relay-cli": {
      "types": "./dist/relay-cli.d.ts",
      "default": "./dist/relay-cli.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "history",
    "search",
    "sqlite",
    "ai-agent",
    "ai-cli",
    "coding-agent",
    "session-history"
  ],
  "homepage": "https://github.com/AgentWorkforce/relayhistory",
  "files": [
    "dist/index.*",
    "dist/native.*",
    "dist/sdk-common.*",
    "dist/delivery.*",
    "dist/delivery-contracts.*",
    "dist/delivery-plugins.*",
    "dist/delivery-cli.*",
    "dist/history-export.*",
    "dist/cli.*",
    "dist/relay-cli.*",
    "dist/cloud-contract.*",
    "dist/mcp-server.*",
    "README.md",
    "package.json",
    "dist/contracts.*",
    "dist/normalization.*",
    "dist/pagination.*",
    "dist/git.*",
    "dist/operations.*",
    "dist/source-contracts.*",
    "dist/source-plugins.*",
    "!dist/*.test.*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentWorkforce/relayhistory",
    "directory": "sdk-ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/*.test.js ../scripts/hydration-benchmark.test.mjs ../scripts/first-search-evidence.test.mjs ../scripts/registry-clean-install-smoke.test.mjs ../scripts/npm-install-with-registry-retry.test.mjs ../scripts/set-release-version.test.mjs",
    "test:architecture": "node --test dist/architecture.test.js",
    "benchmark": "npm run build && node ../scripts/benchmark-native.mjs",
    "benchmark:hydration": "npm run build && node ../scripts/benchmark-hydration.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai-hist-native": "file:../crates/ai-hist-napi",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agent-relay/cli-surface": "^12.2.4",
    "@relayhistory/cloud-client": "^0.1.1",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
