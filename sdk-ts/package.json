{
  "name": "ai-hist",
  "version": "0.15.8",
  "description": "Native-backed TypeScript SDK, CLI, and MCP server for RelayHistory.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ai-hist": "./dist/cli.js",
    "ai-hist-mcp": "./dist/mcp-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloud": {
      "types": "./dist/cloud-client.d.ts",
      "default": "./dist/cloud-client.js"
    },
    "./mcp-server": {
      "types": "./dist/mcp-server.d.ts",
      "default": "./dist/mcp-server.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "history",
    "search",
    "sqlite",
    "ai-agent",
    "ai-cli",
    "coding-agent",
    "session-history"
  ],
  "homepage": "https://github.com/AgentWorkforce/relayhistory",
  "files": [
    "dist/index.*",
    "dist/cli.*",
    "dist/mcp-server.*",
    "dist/cloud-client.*",
    "dist/cloud-auth-bundle.*",
    "dist/cloud-preflight.js",
    "dist/cloud-preflight.js.map",
    "dist/cloud-preflight.d.ts",
    "dist/cloud-preflight.d.ts.map",
    "README.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentWorkforce/relayhistory",
    "directory": "sdk-ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build-cloud-auth.mjs",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/*.test.js ../scripts/hydration-benchmark.test.mjs ../scripts/first-search-evidence.test.mjs ../scripts/registry-clean-install-smoke.test.mjs ../scripts/npm-install-with-registry-retry.test.mjs",
    "test:architecture": "node --test dist/architecture.test.js",
    "benchmark": "npm run build && node ../scripts/benchmark-native.mjs",
    "benchmark:hydration": "npm run build && node ../scripts/benchmark-hydration.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai-hist-native": "file:../crates/ai-hist-napi",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agent-relay/cloud": "^11.8.1",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
